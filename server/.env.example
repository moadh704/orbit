PORT=8080
NODE_ENV=development

# Frontend origin (same as this server URL in single-service production)
CLIENT_URL=http://localhost:5173

# MySQL (local or Render). Render also sets MYSQLHOST etc. — both work.
DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_NAME=orbit

JWT_SECRET=change-me-to-a-long-random-string

# Optional — invites (app works without email)
EMAIL_USER=
EMAIL_PASS=

# Set to "false" only if frontend is hosted separately
SERVE_SPA=true
